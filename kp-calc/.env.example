# Пример переменных для docker-compose. Скопируйте в .env и заполните; .env в репозиторий не попадает.
POSTGRES_PASSWORD=
# Первый владелец создаётся при старте, если в базе нет ни одного владельца. Пароль — не короче 8 символов.
OWNER_EMAIL=
OWNER_PASSWORD=
# OWNER_RESET=1 — один раз задать пароль владельца из OWNER_PASSWORD (если не пускает), потом убрать
# Адрес портала для ссылок-приглашений
PUBLIC_URL=http://localhost:8787
NODE_ENV=production
# TLS к PostgreSQL для облачной базы (Timeweb): 1 — включить (сертификат не проверяется). Локально и в docker compose — пусто.
# Можно вместо этого дописать ?sslmode=require к DATABASE_URL.
DATABASE_SSL=
# Картинки: S3-совместимое хранилище (Timeweb). Пусто — картинки хранятся в PostgreSQL.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1
# Рендер по эскизу: OpenAI-совместимый шлюз (AITunnel, OpenRouter). Пусто — «Рендер не подключён».
RENDER_PROVIDER=openai-compatible
RENDER_API_URL=
RENDER_API_KEY=
RENDER_MODEL=
# Текст «Об изделии» нейросетью. Пусто — шаблонный текст.
AI_TEXT_API_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
