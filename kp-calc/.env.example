# Пример переменных для docker-compose. Скопируйте в .env и заполните; .env в репозиторий не попадает.
POSTGRES_PASSWORD=
# Первый владелец создаётся при старте, если в базе нет ни одного владельца. Пароль — не короче 8 символов.
OWNER_EMAIL=
OWNER_PASSWORD=
# Адрес портала для ссылок-приглашений
PUBLIC_URL=http://localhost:8787
NODE_ENV=production
